<div class="max-w-4xl mx-auto p-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold"><%= @service.name %></h1>
    <div>
      <%= link_to "Edit", edit_service_path(@service), class: "btn btn-primary" %>
      <%= link_to "Back", services_path, class: "btn btn-ghost" %>
    </div>
  </div>

  <div class="mb-8">
    <h2 class="text-xl font-semibold mb-2">Description</h2>
    <p class="text-gray-700"><%= @service.description %></p>
  </div>

  <div class="mb-8">
    <h2 class="text-xl font-semibold mb-4">Pricing Tiers</h2>
    <% if @service.service_tiers.any? %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% @service.service_tiers.each do |tier| %>
          <div class="card bg-base-100 shadow-xl border border-base-200">
            <div class="card-body">
              <h3 class="card-title"><%= tier.service_plan %></h3>
              <p class="text-2xl font-bold text-primary">$<%= tier.price %></p>
              <p class="text-gray-600"><%= tier.description %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 italic">No pricing tiers defined.</p>
    <% end %>
  </div>
</div>
